# 复制为 .env（已在 .gitignore 中，不会入库）

# 数据库：默认 SQLite，换 PostgreSQL 示例
# postgresql+psycopg://user:pass@127.0.0.1:5432/interview_duck
DATABASE_URL=sqlite:///./data/app.db

# 跨域白名单，逗号分隔；开发可用 *，上线必须写具体域名
CORS_ORIGINS=*

# 微信小程序登录（不配也能用游客登录联调）
WX_APPID=
WX_SECRET=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 超过多少毫秒算慢请求（打 WARNING 并标 slow=true）
SLOW_REQUEST_MS=500
