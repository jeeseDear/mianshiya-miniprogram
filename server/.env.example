# 复制为 .env（已在 .gitignore 中，不会入库）

# 数据库：默认 SQLite，换 PostgreSQL 示例
# postgresql+psycopg://user:pass@127.0.0.1:5432/interview_duck
DATABASE_URL=sqlite:///./data/app.db

# 跨域白名单，逗号分隔；开发可用 *，上线必须写具体域名
CORS_ORIGINS=*

# 微信小程序登录（不配也能用游客登录联调）
WX_APPID=
WX_SECRET=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 超过多少毫秒算慢请求（打 WARNING 并标 slow=true）
SLOW_REQUEST_MS=500

# ---------------- AI 解析（大模型） ----------------
# 走 OpenAI 兼容的 /chat/completions 协议，常见填法：
#   DeepSeek  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#             LLM_MODEL=qwen-plus
#   智谱 GLM  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#             LLM_MODEL=glm-4-flash
# 留空则 /api/questions/{id}/ai 返回 503，前端提示「AI 解析未开启」。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.4
